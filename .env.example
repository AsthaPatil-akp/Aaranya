# Darukaa.Earth — environment variables
# Copy this file to .env and fill in values. Never commit .env.

# --- Application ---
APP_NAME=Darukaa.Earth
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# --- Paths ---
DATA_DIR=./data
KNOWLEDGE_DIR=./knowledge
PDF_DIR=./knowledge/pdfs
SOURCE_DIR=./knowledge/sources

# --- Retrieval ---
# embedding_backend: hashing | sentence-transformers | openai
EMBEDDING_BACKEND=hashing
EMBEDDING_MODEL=all-MiniLM-L6-v2
RELEVANCE_THRESHOLD=0.28
RETRIEVAL_TOP_K=6
CHUNK_SIZE=900
CHUNK_OVERLAP=140

# --- Optional LLM (never required; reasoning works without it) ---
# If set, used only to polish explanations. Sources still come only from retrieval.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
LLM_PROVIDER=none

# --- Optional external scientific search (OpenAlex, no key required) ---
ENABLE_OPENALEX=true
OPENALEX_MAILTO=darukaa-prototype@example.org

# --- Security ---
# Do not put secrets in the frontend. The Vite app only talks to this API.

# Darukaa.Earth — environment variables
# Copy this file to .env. Never commit secrets.

APP_NAME=Darukaa.Earth
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

DATA_DIR=./data
KNOWLEDGE_DIR=./knowledge
PDF_DIR=./knowledge/pdfs
SOURCE_DIR=./knowledge/sources

EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
RELEVANCE_THRESHOLD=0.42
WEAK_KB_THRESHOLD=0.52
RETRIEVAL_TOP_K=8
CHUNK_SIZE=900
CHUNK_OVERLAP=140

CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=darukaa_knowledge

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=120

# Optional paid provider — not required
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

ENABLE_OPENALEX=true
OPENALEX_MAILTO=darukaa-prototype@example.org
FETCH_OPEN_ACCESS_TEXT=true

ADMIN_API_TOKEN=dev-admin-token

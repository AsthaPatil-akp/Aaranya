# Copy to `.env` at the repo root. Never commit `.env`.
# Local defaults keep `npm run dev` and Ollama-on-localhost working.

# --- Backend / LLM ---
APP_NAME=Aaranya
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
# Cloud hosts inject PORT. That value wins over API_PORT.
# PORT=8000
LLM_PROVIDER=ollama
# Local process: http://localhost:11434
# Docker Compose API service: http://ollama:11434 (already set in docker-compose.yml)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=120
# Render / production hosted LLM (leave commented for local Ollama)
# LLM_PROVIDER=groq
# GROQ_API_KEY=your-groq-api-key-here
# GROQ_MODEL=llama-3.1-8b-instant
# Optional paid OpenAI instead of Groq
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Database / vector store ---
DATA_DIR=./data
SQLITE_PATH=./data/darukaa.sqlite
KNOWLEDGE_DIR=./knowledge
PDF_DIR=./knowledge/pdfs
SOURCE_DIR=./knowledge/sources
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=darukaa_knowledge
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
RELEVANCE_THRESHOLD=0.42
WEAK_KB_THRESHOLD=0.52
RETRIEVAL_TOP_K=8
CHUNK_SIZE=900
CHUNK_OVERLAP=140

# --- Admin / security / CORS ---
ADMIN_API_TOKEN=your-long-random-admin-token-here
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Set this to the live Netlify origin after the frontend is deployed (no trailing slash).
FRONTEND_ORIGIN=https://YOUR-NETLIFY-SITE.netlify.app
# Optional. Leave empty in production unless you need Netlify deploy-preview origins.
# CORS_ORIGIN_REGEX=https://.*\.netlify\.app

# --- Optional OpenAlex ---
ENABLE_OPENALEX=true
OPENALEX_MAILTO=you@example.com
FETCH_OPEN_ACCESS_TEXT=true
